PROJECT_NAME="Student Placement Management System (SPMS)"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# MongoDB Database Configuration
# Primary: MongoDB Atlas Cloud Cluster
# Format: mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_URL="mongodb+srv://<db_username>:<db_password>@<cluster-url>/?retryWrites=true&w=majority"
DATABASE_NAME="spms_db"

# Security & JWT Signing Secret
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="your-cryptographically-secure-jwt-signing-secret-placeholder-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Explicit CORS Allowed Origins (comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Demo Account Credentials (Development only)
DEMO_ADMIN_PASSWORD="ChangeMeInDev123!"
DEMO_STUDENT_PASSWORD="ChangeMeInDev123!"
DEMO_RECRUITER_PASSWORD="ChangeMeInDev123!"
ENABLE_DEMO_SEEDING="true"
